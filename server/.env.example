# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Set to true to let Express also serve client/dist (single-host deployment)
SERVE_CLIENT=false

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hotel_reservation

# ---- Auth ----
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
# lax works for localhost and same-site hosting. Use "none" (requires HTTPS) when client and API are on different sites.
COOKIE_SAMESITE=lax

# ---- Pricing (percent values) ----
TAX_RATE=12
SERVICE_FEE_RATE=5
MAX_STAY_NIGHTS=30

# ---- Demo data (used only by npm run db:setup) ----
DEMO_ADMIN_EMAIL=admin@stayease.test
DEMO_ADMIN_PASSWORD=Admin@12345
DEMO_CUSTOMER_EMAIL=guest@stayease.test
DEMO_CUSTOMER_PASSWORD=Guest@12345
